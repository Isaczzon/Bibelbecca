---
layout: layout.njk
aktiv: media
pagination:
  data: locales
  size: 1
  alias: loc
permalink: "/{{ loc.prefix }}media/index.html"
eleventyComputed:
  titel: "{{ pages[loc.code].media.navnamn }}"
---
{%- set kod = loc.code -%}
{%- set sidan = pages[kod].media -%}
{%- set ui = t[kod] -%}
{%- set sajten = sajt[kod] -%}
{%- set allaMedia = collections.media | medLang(kod) | nyastForst -%}

{% macro mediaSektion(rubrik, undertitel, inslag, ankare, staende=false) %}
<div class="section" id="{{ ankare }}">
    <div class="section-header fade-in">
        <h2>{{ rubrik }}</h2>
        <p>{{ undertitel }}</p>
    </div>
    {% if inslag.length %}
    <div class="{% if staende %}shorts-list{% else %}video-list{% endif %}">
        {% for post in inslag %}
        {% set ytid = post.data.url | youtubeId %}
        <div class="video-block fade-in">
            <div class="video-embed{% if staende %} video-embed--staende{% endif %}">
                <button type="button" class="video-facade" data-yt="{{ ytid }}" aria-label="{{ ui.spela }}: {{ post.data.titel }}">
                    <img src="https://i.ytimg.com/vi/{{ ytid }}/{% if staende %}oardefault{% else %}hqdefault{% endif %}.jpg" alt="" loading="lazy"{% if staende %} onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ ytid }}/hqdefault.jpg';"{% endif %}>
                    <span class="video-play" aria-hidden="true">▶</span>
                </button>
            </div>
            <h3>{{ post.data.titel }}</h3>
            {% if post.data.datum %}<p class="video-date">{{ post.data.datum | datumLokal(kod) }}</p>{% endif %}
            {% if post.data.beskrivning %}<p class="video-description">{{ post.data.beskrivning }}</p>{% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="media-empty fade-in">
        <p>{{ ui.mediaTomt }}</p>
        {% if sajten.youtube %}<a class="hero-btn hero-btn--alt" href="{{ sajten.youtube }}" target="_blank" rel="noopener">▶ {{ ui.prenumerera }}</a>{% endif %}
    </div>
    {% endif %}
</div>
{% endmacro %}

<section class="subpage-hero"{% if sidan.hero.bild %} style="background-image: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.55)), url('{{ sidan.hero.bild | url }}'); background-size: cover; background-position: center;"{% endif %}>
    <h1>{{ sidan.hero.rubrik }}</h1>
    <p>{{ sidan.hero.undertitel }}</p>
</section>

{{ mediaSektion(sidan.videor.rubrik, sidan.videor.undertitel, allaMedia | medTyp('Video'), 'videor') }}

<section class="section-alt">
    {{ mediaSektion(sidan.shorts.rubrik, sidan.shorts.undertitel, allaMedia | medTyp('Short'), 'shorts', staende=true) }}
</section>

{{ mediaSektion(sidan.podcast.rubrik, sidan.podcast.undertitel, allaMedia | medTyp('Podcast'), 'podcast') }}
{% if sajten.spotify %}
<p style="text-align:center; padding-bottom:48px; margin-top:-48px;">
    <a class="hero-btn hero-btn--alt" href="{{ sajten.spotify }}" target="_blank" rel="noopener">🎧 {{ ui.lyssnaSpotify }}</a>
</p>
{% endif %}

<section class="section-alt">
    {{ mediaSektion(sidan.lives.rubrik, sidan.lives.undertitel, allaMedia | medTyp('Live'), 'lives') }}
</section>
